{
    "name": "wbs-node-ts-template",
    "version": "1.0.0",
    "description": "",
    "keywords": [],
    "license": "ISC",
    "author": "",
    "type": "module",
    "main": "dist/app.js",
    "imports": {
        "#utils": {
            "development": "./src/utils/index.ts",
            "default": "./dist/utils/index.js"
        }
    },
    "scripts": {
        "dev": "node --watch --env-file-if-exists=.env --conditions development src/app.ts",
        "prebuild": "rm -rf dist",
        "build": "tsc",
        "prestart": "npm run build",
        "start": "node --env-file-if-exists=.env dist/app.js",
        "dev:test": "node --env-file-if-exists=.env.test --conditions development src/app.ts",
        "user:test": "node --env-file-if-exists=.env --conditions development src/commands/create-test-user.ts",
        "orm": "MIKRO_ORM_CLI_PREFER_TS=1 node --env-file-if-exists=.env --conditions development node_modules/@mikro-orm/cli/cli.js",
        "orm:test": "MIKRO_ORM_CLI_PREFER_TS=1 node --env-file-if-exists=.env.test --conditions development node_modules/@mikro-orm/cli/cli.js"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^24.13.3",
        "typescript": "^6.0"
    },
    "dependencies": {
        "@mikro-orm/cli": "^7.2.3",
        "@mikro-orm/core": "^7.2.3",
        "@mikro-orm/mariadb": "^7.2.3",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^18.0.5",
        "express": "^5.2.1",
        "prettier": "^3.9.9",
        "zod": "^4.6.5"
    }
}
